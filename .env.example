# ---- Required ----
# Free Google Gemini key: https://aistudio.google.com/apikey
# Powers both lesson writing and the AI narrator voice.
GEMINI_API_KEY=
# Any long random string; protects login sessions.
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Optional: models ----
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# How much the model "thinks" before writing: minimal | low | medium | high
GEMINI_THINKING=low
# Scenes written in parallel (lower it if the free tier keeps hitting rate limits).
AI_CONCURRENCY=2

# ---- Optional: use other providers instead ----
# AI_PROVIDER=anthropic        # gemini (default) | anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# TTS_PROVIDER=openai          # gemini (default) | openai
# OPENAI_API_KEY=
# OPENAI_TTS_MODEL=tts-1

# ---- Server ----
# AI requests allowed per user per day.
AI_DAILY_LIMIT=300
# Set to 1 to stop new sign-ups (existing users can still log in).
DISABLE_SIGNUP=0
PORT=3000
# Set to 1 when served over HTTPS so session cookies are marked Secure.
COOKIE_SECURE=0
# Python sandbox: "socket" (Docker sandbox container, recommended), "local-unsafe" (dev only), or "off".
SANDBOX_MODE=socket
SANDBOX_SOCKET=/sock/sandbox.sock
DATA_DIR=./data
